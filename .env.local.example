# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Absolute origin, no trailing slash. Used for canonical URLs, OG tags,
# sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Firebase Admin (server only — never prefix these with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
# From the service account JSON in Firebase console → Project settings →
# Service accounts → Generate new private key.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Keep the surrounding quotes and the literal \n sequences from the JSON file.
FIREBASE_PRIVATE_KEY=""

# All three must be present or the Admin SDK stays uninitialised and the site
# falls back to the mock data in src/lib/data/*.

# ---------------------------------------------------------------------------
# Cloudflare R2 (media)
# ---------------------------------------------------------------------------
# Public bucket URL — its hostname is added to next.config.ts remotePatterns.
NEXT_PUBLIC_R2_PUBLIC_URL=""

# Server-side credentials for uploads (R2 → Manage API tokens).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# e.g. https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=""

# ---------------------------------------------------------------------------
# Cache invalidation
# ---------------------------------------------------------------------------
# Shared secret sent as x-revalidate-secret to POST /api/revalidate.
REVALIDATE_SECRET=""
